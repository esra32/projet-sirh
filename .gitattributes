# ============================================================
#  SIRH – .gitattributes
#  Ensures consistent line endings across OS
# ============================================================

# Default: normalize to LF in repository, checkout as-is
* text=auto eol=lf

# Force LF for shell scripts (they break with CRLF)
*.sh    text eol=lf
*.bash  text eol=lf

# Force CRLF for Windows-specific scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Source code – always LF
*.java          text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.xml           text eol=lf
*.properties    text eol=lf
*.sql           text eol=lf
*.html          text eol=lf
*.scss          text eol=lf
*.css           text eol=lf
*.md            text eol=lf

# Binary files – no text processing
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.jar   binary
*.war   binary
*.zip   binary
*.pdf   binary
